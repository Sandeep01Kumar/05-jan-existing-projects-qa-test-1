# .env.example — environment variable template for hao-backprop-test
# Copy this file to .env (which is gitignored) and adjust values for your local environment.
# These variables are consumed by app/config.py via python-dotenv during create_app() bootstrap.

# Flask runtime environment: one of "development", "production", "testing".
FLASK_ENV=development

# Dotted import path of the config class loaded by create_app().
# Options: app.config.DevConfig | app.config.ProdConfig | app.config.TestConfig
FLASK_CONFIG=app.config.DevConfig

# Host/port the Flask service binds to. Defaults preserve byte-level parity with the
# retired Node.js server (server.js used 127.0.0.1:3000).
HOST=127.0.0.1
PORT=3000

# Python logging level for app.logger. One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Flask secret key (used by session signing; not consumed by the current Hello World route,
# but required for any future feature that calls flask.session or flask.flash).
SECRET_KEY=change-me
