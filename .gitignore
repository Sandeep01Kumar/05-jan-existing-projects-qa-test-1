# =============================================================================
# Python/Flask .gitignore
# =============================================================================
# This file specifies patterns for files and directories that should be
# excluded from version control in this Python Flask application.
# =============================================================================

# -----------------------------------------------------------------------------
# Virtual Environment Folders
# -----------------------------------------------------------------------------
# Python virtual environments should never be committed to version control.
# Different developers may use different folder names for their environments.
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# -----------------------------------------------------------------------------
# Python Bytecode and Cache Files
# -----------------------------------------------------------------------------
# Compiled Python files are auto-generated and machine-specific.
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# -----------------------------------------------------------------------------
# Distribution and Packaging
# -----------------------------------------------------------------------------
# Build artifacts from setuptools, pip, and other packaging tools.
dist/
build/
eggs/
*.egg-info/
*.egg
MANIFEST
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# -----------------------------------------------------------------------------
# Flask-Specific
# -----------------------------------------------------------------------------
# Flask instance folder contains local configuration and should not be shared.
instance/
.webassets-cache

# -----------------------------------------------------------------------------
# IDE and Editor Configurations
# -----------------------------------------------------------------------------
# IDE settings are personal preferences and should not be shared across team.

# JetBrains (PyCharm, IntelliJ)
.idea/
*.iml
*.ipr
*.iws

# Visual Studio Code
.vscode/
*.code-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp

# Sublime Text
*.sublime-workspace
*.sublime-project

# Spyder
.spyderproject
.spyproject

# -----------------------------------------------------------------------------
# Environment and Configuration Files
# -----------------------------------------------------------------------------
# Environment files may contain secrets, API keys, or sensitive configuration.
# IMPORTANT: .env files with credentials should NEVER be committed.
.env
.env.local
.env.*.local
*.env
.flaskenv

# Local configuration overrides
config.local.py
settings.local.py
local_settings.py

# -----------------------------------------------------------------------------
# Testing and Quality Assurance
# -----------------------------------------------------------------------------
# Pytest
.pytest_cache/
.cache/
pytest_cache/

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
coverage.json
*.cover
*.py,cover
.hypothesis/
nosetests.xml

# tox
.tox/
.nox/

# -----------------------------------------------------------------------------
# Type Checking and Linting
# -----------------------------------------------------------------------------
# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Ruff
.ruff_cache/

# -----------------------------------------------------------------------------
# Jupyter Notebooks
# -----------------------------------------------------------------------------
# Checkpoint files are auto-generated by Jupyter.
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IPython
profile_default/
ipython_config.py

# -----------------------------------------------------------------------------
# Logging and Temporary Files
# -----------------------------------------------------------------------------
# Log files
*.log
logs/
log/

# Temporary files
*.tmp
*.temp
*.bak
.tmp/
tmp/
temp/

# -----------------------------------------------------------------------------
# Database Files
# -----------------------------------------------------------------------------
# SQLite databases (commonly used for Flask development)
*.db
*.sqlite
*.sqlite3

# -----------------------------------------------------------------------------
# Operating System Files
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# -----------------------------------------------------------------------------
# Documentation Build Artifacts
# -----------------------------------------------------------------------------
# Sphinx documentation
docs/_build/
doc/_build/

# mkdocs documentation
/site/

# -----------------------------------------------------------------------------
# Installer Logs
# -----------------------------------------------------------------------------
pip-log.txt
pip-delete-this-directory.txt

# -----------------------------------------------------------------------------
# Miscellaneous
# -----------------------------------------------------------------------------
# Celery task queue
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Rope project settings
.ropeproject/

# Translations
*.mo
*.pot

# Scrapy
.scrapy/

# PyBuilder
.pybuilder/
target/

# PEP 582
__pypackages__/

# Cython debug symbols
cython_debug/
